# ---------------------------------------------------------------------------
# Runtime state and downloaded dependencies.
#
# The optional launchers and the proxy pin every cache inside the workspace
# (see plugin/bin/*.cmd), so these appear next to the source after a single
# run and add up to ~2 GB. They are all regenerated on demand — never commit
# them. (The bundle's own MCP row runs `uvx` with default per-user caches and
# writes none of these.)
# ---------------------------------------------------------------------------
.uv-cache/
.uv-tools/
.uv-bin/
.tiktoken-cache/
.headroom/
.proxy-venv/
.hf-cache/

# Local profile backup written while wiring the proxy into a DSH profile.
.profile-backup/

# ---------------------------------------------------------------------------
# Verification scratch files (the verifier and the README handshake recipe
# write these and clean them up; ignore them in case a run is interrupted).
# ---------------------------------------------------------------------------
.req.jsonl
.out.txt
.proxy-body.json

# ---------------------------------------------------------------------------
# Local audit / test leftovers — machine-specific, may embed local absolute
# paths. Never commit.
# ---------------------------------------------------------------------------
.recon/
.audit-*
.proxy-audit*
.kompress-*
*.log
*.incomplete

# ---------------------------------------------------------------------------
# Node / Python
# ---------------------------------------------------------------------------
node_modules/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------------------------------------------------------------------------
# Secrets — never commit credentials
# ---------------------------------------------------------------------------
.env
.env.*
*.credentials.yaml
.credentials.yaml
*.pem
*.key

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
